---
/**
 * DocumentLayout — Layer 2.  SPEC §4.2, §5.3.4, §8.2.
 *
 * "A technical note or a preprint that happens to be well designed." No cards,
 * no floating panels, no gradients, no drop shadows — the page IS the
 * document. Structure comes from rules, numbering and margins.
 *
 * The mood switch is carried entirely by tokens and this file. The four brand
 * invariants of §4.3 survive it: the same green (less of it), the same motif
 * geometry (frozen), the same heading typeface, the same ink.
 */
import BaseLayout from './BaseLayout.astro';
/* Layer 2's stylesheet, and only Layer 2's. Without it this page is an
   unstyled document — no reading column, no gutters, no numbered sections —
   which is exactly what it looked like before v0.6. */
import '~/styles/document.css';
/* §8.2.5 — rehype-katex emits KaTeX's markup at build time, and KaTeX's markup
   is meaningless without KaTeX's stylesheet: unstyled it renders as the raw
   token soup rather than as an equation. Self-hosted from node_modules, no
   CDN (§5.2.2). */
import 'katex/dist/katex.min.css';
import DocHeader from '~/components/document/DocHeader.astro';
import Toc, { type Heading } from '~/components/document/Toc.astro';
import MotifFrame from '~/components/common/MotifFrame.astro';
import Icon from '~/components/common/Icon.astro';
import { site, en } from '~/lib/site.ts';
import type { MotifId } from '~/motifs/index.ts';

interface Props {
	title: string;
	subtitle?: string;
	description: string;
	headings: Heading[];
	breadcrumb?: { label: string; href: string };
	breadcrumbCurrent?: string;
	motif?: MotifId;
	motifSurface?: 'green' | 'white';
	/** Shared-element key for the page transition (§4.4). */
	transitionKey?: string;
	ogImage?: string;
	jsonLd?: Record<string, unknown>;
	canonical?: string;
	/** Meta line under the title: dates, reading time. */
	meta?: string;
}

const {
	title,
	subtitle,
	description,
	headings,
	breadcrumb,
	breadcrumbCurrent,
	motif,
	motifSurface = 'white',
	transitionKey,
	ogImage,
	jsonLd,
	canonical,
	meta,
} = Astro.props;
---

<BaseLayout
	title={`${title} · ${site.name}`}
	description={description}
	layer="depth"
	lang={site.docLang}
	ogType="article"
	ogImage={ogImage}
	jsonLd={jsonLd}
	canonical={canonical}
	class="doc layer-depth"
>
	<DocHeader sectionTitle={title} />

	<main id="content" class="doc__grid" data-copy={en.copy} data-copied={en.copied}>
		<div class="doc__main">
			<header class="doc-title doc-enter" style="--doc-enter-at:0ms">
				<div class="doc-title__text">
					{
						breadcrumb && (
							<p class="doc-title__crumb t-meta">
								<a href={breadcrumb.href}>{breadcrumb.label}</a>
								<span aria-hidden="true"> / </span>
								<span>{breadcrumbCurrent ?? title}</span>
							</p>
						)
					}
					<h1 class="t-h1">{title}</h1>
					{subtitle && <p class="doc-title__subtitle t-lead">{subtitle}</p>}
					{meta && <p class="doc-title__meta t-meta t-tabular">{meta}</p>}
				</div>

				{
					/* The visual bridge from the card: the same motif, frozen at
					   its poster frame, 200px, right-aligned at lg+ (§8.2.1). */
					motif && (
						<div class="doc-title__motif">
							<MotifFrame id={motif} surface={motifSurface} transitionKey={transitionKey} />
						</div>
					)
				}
			</header>

			<div class="doc-enter" style="--doc-enter-at:60ms">
				<slot name="facts" />
				<Toc headings={headings} variant="inline" />
			</div>

			<div class="prose doc-enter" style="--doc-enter-at:120ms">
				<slot />
			</div>

			<slot name="after" />

			<p class="doc-contact t-small">
				{en.questions} <a href={`mailto:${site.email}`}>{site.email}</a>
			</p>

			<slot name="next" />
		</div>

		<aside class="doc__toc">
			<Toc headings={headings} />
		</aside>
	</main>

	<footer class="doc-foot">
		<div class="doc-foot__inner t-meta">
			<a href="/">{site.name}</a>
			<a href={site.cv.fr.href} download={site.cv.available ? '' : undefined}>
				{site.strings.fr.cta.primary}
				<Icon name={site.cv.available ? 'download' : 'arrow-right'} size={12} />
			</a>
			{
				site.social.repo && (
					<a href={site.social.repo} rel="noopener" target="_blank">
						{site.strings.fr.footer.viewSource}
					</a>
				)
			}
		</div>
	</footer>
</BaseLayout>

<style>
	.doc__grid {
		padding-top: var(--space-12);
		padding-bottom: var(--space-20);
	}

	.doc-title {
		display: grid;
		gap: var(--space-6);
		padding-bottom: var(--space-8);
		border-bottom: var(--border-hair);
	}

	.doc-title__crumb {
		color: var(--ink-500);
		margin-bottom: var(--space-3);
	}
	.doc-title__crumb a {
		color: var(--ink-500);
		text-decoration: none;
	}
	.doc-title__crumb a:hover {
		color: var(--ink-900);
	}

	.doc-title h1 {
		margin: 0;
	}

	.doc-title__subtitle {
		margin-top: var(--space-4);
		color: var(--ink-700);
		max-width: 32em;
	}

	.doc-title__meta {
		margin-top: var(--space-4);
		color: var(--ink-500);
	}

	/* Above the title on mobile, right-aligned beside it from lg (§8.2.1). */
	.doc-title__motif {
		width: 128px;
		order: -1;
	}
	@media (min-width: 1024px) {
		.doc-title {
			grid-template-columns: 1fr 200px;
			align-items: start;
			gap: var(--space-10);
		}
		.doc-title__motif {
			width: 200px;
			order: 0;
		}
	}

	.doc-contact {
		margin-top: var(--space-12);
		color: var(--ink-500);
	}
	.doc-contact a {
		color: var(--ink-900);
		text-decoration: underline;
		text-decoration-color: var(--green-500);
		text-decoration-thickness: 2px;
		text-underline-offset: 3px;
	}

	.doc-foot {
		border-top: var(--border-hair);
		padding-block: var(--space-8);
	}
	.doc-foot__inner {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-6);
		max-width: calc(var(--container-doc) + 2 * var(--gutter));
		margin-inline: auto;
		padding-inline: var(--gutter);
		color: var(--ink-500);
	}
	.doc-foot__inner a {
		display: inline-flex;
		align-items: center;
		gap: var(--space-1);
		color: var(--ink-500);
		text-decoration: none;
	}
	.doc-foot__inner a:hover {
		color: var(--ink-900);
	}

	/* §4.4 step 5 — body content fades and rises 12px with a 60 ms stagger
	   across the first three blocks. Guarded by the media query so that if the
	   animation never runs, the content was never hidden. */
	@media (prefers-reduced-motion: no-preference) {
		.doc-enter {
			animation: doc-enter var(--dur-base) var(--ease-entrance) both;
			animation-delay: var(--doc-enter-at, 0ms);
		}
	}

	@keyframes doc-enter {
		from {
			opacity: 0;
			transform: translateY(12px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}
</style>

<script>
	/* Copy button on code blocks (§8.2.5), added by script so the markup stays
	   the plain <pre><code> that Shiki emits and that prints correctly. */
	const main = document.getElementById('content');
	const blocks = document.querySelectorAll<HTMLPreElement>('.prose pre');

	/* Labels come from site.config.yaml like every other string (§9.3). */
	const idle = main?.dataset.copy ?? '';
	const done = main?.dataset.copied ?? idle;

	for (const block of blocks) {
		const wrapper = document.createElement('div');
		wrapper.className = 'code-block';
		block.parentNode?.insertBefore(wrapper, block);
		wrapper.appendChild(block);

		const button = document.createElement('button');
		button.type = 'button';
		button.className = 'copy-button t-meta';
		button.textContent = idle;

		button.addEventListener('click', async () => {
			try {
				await navigator.clipboard.writeText(block.innerText);
				button.textContent = done;
				setTimeout(() => {
					button.textContent = idle;
				}, 1600);
			} catch {
				/* Clipboard denied — leave the label alone rather than claim
				   something happened that did not. */
			}
		});

		wrapper.appendChild(button);
	}
</script>

<style is:global>
	.code-block {
		position: relative;
	}
	.copy-button {
		position: absolute;
		top: var(--space-3);
		right: var(--space-3);
		padding: var(--space-1) var(--space-3);
		background: var(--paper);
		border: var(--border-hair);
		border-radius: var(--radius-sm);
		color: var(--ink-500);
		cursor: pointer;
		opacity: 0;
		transition: opacity var(--dur-fast) var(--ease-standard);
	}
	.code-block:hover .copy-button,
	.copy-button:focus-visible {
		opacity: 1;
	}
</style>
