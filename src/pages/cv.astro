---
/**
 * CV page (/cv) — SPEC §8.4.
 *
 * "Exists so that 'envoie-moi ton CV' can be answered with a URL." Minimal by
 * design: two buttons, the file facts, and a preview at lg+. The PDF is the
 * source of truth for every fact the site deliberately does not restate
 * (§3.3, §16).
 */
import SurfaceLayout from '~/layouts/SurfaceLayout.astro';
import Button from '~/components/common/Button.astro';
import { site, t } from '~/lib/site.ts';
---

<SurfaceLayout
	title={`${t.cvPage.title} · ${site.name}`}
	description={t.cvPage.lead}
	ogImage={`/og/home.${site.og.format}`}
	noIndex
>
	<section class="cv">
		<div class="u-container">
			<h1 class="t-h1">{t.cvPage.title}</h1>
			<p class="cv__lead t-lead u-measure">{t.cvPage.lead}</p>

			{
				/* The download buttons and the file facts both describe a PDF. Until
				   one exists they would point this page at itself and label two empty
				   values, so the note below carries the page on its own. */
				site.cv.available && (
					<Fragment>
						<div class="cv__actions">
							<Button href={site.cv.fr.href} variant="primary" icon="download" download>
								{t.cvPage.downloadFr}
							</Button>
							<Button href={site.cv.en.href} variant="secondary" icon="download" download>
								{t.cvPage.downloadEn}
							</Button>
						</div>

						<dl class="cv__facts t-meta">
							<div>
								<dt>{t.cvPage.updatedLabel}</dt>
								<dd class="t-tabular">{site.cv.fr.updated}</dd>
							</div>
							<div>
								<dt>{t.cvPage.sizeLabel}</dt>
								<dd class="t-tabular">{site.cv.fr.size}</dd>
							</div>
						</dl>
					</Fragment>
				)
			}

			{
				site.cv.available ? (
					<div class="cv__preview">
						<object data={site.cv.fr.href} type="application/pdf" aria-label={t.cvPage.previewLabel}>
							<p class="t-small">
								{t.cvPage.previewFallback}{' '}
								<a class="link" href={site.cv.fr.href} download>
									{t.cvPage.downloadFr}
								</a>
							</p>
						</object>
					</div>
				) : (
					/* Honest rather than broken: S1 is still satisfied because the
					   home CTA reaches this page in one click, and this says plainly
					   that the file is not there yet. */
					<p class="cv__missing t-small">
						<strong>{t.cvPage.missing}</strong> {t.cvPage.missingHint}
					</p>
				)
			}
		</div>
	</section>
</SurfaceLayout>

<style>
	.cv {
		padding-block: var(--space-12) var(--space-16);
	}

	.cv__lead {
		margin-top: var(--space-5);
		color: var(--ink-700);
	}

	.cv__actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-4);
		margin-top: var(--space-10);
	}

	.cv__facts {
		display: flex;
		gap: var(--space-10);
		margin-top: var(--space-6);
		color: var(--ink-500);
	}
	.cv__facts dt {
		display: inline;
	}
	.cv__facts dd {
		display: inline;
		margin: 0 0 0 var(--space-2);
		color: var(--ink-900);
	}

	/* Preview at lg and up only — an embedded PDF viewer on a phone is a
	   worse experience than the download the visitor came for (§8.4). */
	.cv__preview {
		display: none;
	}
	@media (min-width: 1024px) {
		.cv__preview {
			display: block;
			margin-top: var(--space-12);
			height: 80vh;
			border-radius: var(--radius-md);
			overflow: hidden;
			background: var(--paper);
			box-shadow: var(--shadow-card);
		}
		.cv__preview object {
			width: 100%;
			height: 100%;
		}
	}

	.cv__missing {
		margin-top: var(--space-10);
		padding: var(--space-5);
		border-left: 3px solid var(--ink-300);
		background: var(--paper);
		border-radius: 0 var(--radius-md) var(--radius-md) 0;
		color: var(--ink-700);
	}
</style>
