---
/**
 * The whole icon set. Five glyphs, drawn on the same 16px grid with the same
 * 1.5px stroke as the isometric system (§6.1), so nothing on the site is
 * stroked at a weight that appears nowhere else.
 *
 * No icon font, no sprite sheet, no dependency.
 */
interface Props {
	name: 'download' | 'arrow-right' | 'arrow-left' | 'external' | 'rss';
	size?: number;
	class?: string;
}

const { name, size = 16, class: className = '' } = Astro.props;

const paths: Record<Props['name'], string> = {
	download: 'M8 2v9M4.5 7.5 8 11l3.5-3.5M3 13.2h10',
	'arrow-right': 'M3 8h10M9 4l4 4-4 4',
	'arrow-left': 'M13 8H3M7 4 3 8l4 4',
	external: 'M6 3h7v7M13 3 6.5 9.5M11 10.5V13H3V5h2.5',
	rss: 'M3.5 12.5h.01M3.5 8.5a4 4 0 0 1 4 4M3.5 4.5a8 8 0 0 1 8 8',
};
---

<svg
	class:list={['icon', className]}
	width={size}
	height={size}
	viewBox="0 0 16 16"
	fill="none"
	stroke="currentColor"
	stroke-width="1.5"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
	focusable="false"
>
	<path d={paths[name]}></path>
</svg>

<style>
	.icon {
		flex: none;
		display: inline-block;
		vertical-align: middle;
	}
</style>
