---
/**
 * The slim sticky header — SPEC §3.2.
 *
 * "Layer 2 pages have a slim sticky header: back-arrow wordmark on the left,
 * section title in the middle (desktop only), CV on the right. It is the only
 * cross-layer chrome."
 *
 * The section title in the middle is what stops a deep-linked reader — the one
 * who arrived from an email straight into §6 — from wondering whose page this
 * is.
 */
import Icon from '~/components/common/Icon.astro';
import Wordmark from '~/components/common/Wordmark.astro';
import { site, t } from '~/lib/site.ts';

interface Props {
	/** Shown in the middle at lg and up. */
	sectionTitle?: string;
}

const { sectionTitle } = Astro.props;
---

<header class="doc-header">
	<div class="doc-header__inner">
		<a class="doc-header__back" href="/">
			<Icon name="arrow-left" size={14} />
			<Wordmark href="/" />
		</a>

		{sectionTitle && <span class="doc-header__title t-meta">{sectionTitle}</span>}

		<a class="doc-header__cv t-meta" href={site.cv.fr.href} download={site.cv.available ? '' : undefined}>
			{t.cta.primaryMobile}
			<Icon name={site.cv.available ? 'download' : 'arrow-right'} size={14} />
		</a>
	</div>
</header>

<style>
	.doc-header {
		position: sticky;
		top: 0;
		z-index: 10;
		height: var(--space-14);
		background: color-mix(in srgb, var(--paper) 88%, transparent);
		backdrop-filter: saturate(1.4) blur(8px);
		border-bottom: var(--border-hair);
	}

	.doc-header__inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-4);
		height: 100%;
		max-width: calc(var(--container-doc) + 2 * var(--gutter));
		margin-inline: auto;
		padding-inline: var(--gutter);
	}

	.doc-header__back {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		color: var(--ink-500);
		text-decoration: none;
	}
	.doc-header__back:hover {
		color: var(--ink-900);
	}

	.doc-header__title {
		display: none;
		color: var(--ink-500);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	@media (min-width: 1024px) {
		.doc-header__title {
			display: block;
		}
	}

	.doc-header__cv {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		font-weight: 600;
		color: var(--ink-900);
		text-decoration: none;
		padding: var(--space-2) var(--space-4);
		border: var(--border-pill);
		border-radius: var(--radius-pill);
		transition: background-color var(--dur-fast) var(--ease-standard);
	}
	.doc-header__cv:hover {
		background: rgb(16 17 19 / 0.06);
	}
</style>
